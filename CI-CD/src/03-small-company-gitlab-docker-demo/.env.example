# 部署机环境变量模板
# 复制为 .env 并填实际值，.env 不入库（加到 .gitignore）
# docker-compose 会自动读取同目录的 .env

# 当前部署环境
APP_ENV=dev

# 镜像 tag（由 CI 部署脚本注入，这里给默认值用于本地调试）
IMAGE_TAG=latest

# 数据库配置
DB_HOST=mysql.internal
DB_NAME=myapp
DB_USER=myapp
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# 日志级别
LOG_LEVEL=INFO
